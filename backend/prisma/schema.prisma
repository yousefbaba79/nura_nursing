generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// NOTE: Enumerated fields below are plain Strings rather than native Postgres
// enums, so adding a new allowed value never requires a migration. Allowed
// values are validated in application code (see backend/src/utils/enums.ts)
// and documented in comments here.

// ---------------------------------------------------------------------------
// Consultant / account
// ---------------------------------------------------------------------------

model Consultant {
  id                String   @id @default(cuid())
  email             String   @unique
  passwordHash      String
  fullName          String
  professionalTitle String?
  phone             String?
  clinicName        String?
  clinicAddress     String?
  profileImageUrl   String?
  defaultLanguage   String   @default("en")
  timeZone          String   @default("UTC")
  dateFormat        String   @default("MM/DD/YYYY")
  defaultVisitDurationMinutes Int @default(60)
  sessionTimeoutMinutes        Int @default(30)
  failedLoginAttempts Int    @default(0)
  lockedUntil       DateTime?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  clients        Client[]
  auditEntries   AuditEntry[]
  passwordResets PasswordReset[]
  noteTemplates  NoteTemplate[]
}

model PasswordReset {
  id           String     @id @default(cuid())
  token        String     @unique
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
}

// ---------------------------------------------------------------------------
// Client
// ---------------------------------------------------------------------------
// status: ACTIVE | FOLLOW_UP_REQUIRED | TREATMENT_COMPLETED | ARCHIVED

model Client {
  id                 String       @id @default(cuid())
  consultantId       String
  consultant         Consultant   @relation(fields: [consultantId], references: [id])

  fullName           String
  phone              String
  email              String?
  dateOfBirth        DateTime?
  idNumber           String?
  clientNumber       String?
  address            String?
  city               String?
  preferredLanguage  String?
  preferredContactMethod String?
  occupation         String?
  emergencyContactName  String?
  emergencyContactPhone String?
  referralSource     String?
  generalNotes       String?
  tags               String?      // comma separated
  status             String       @default("ACTIVE")

  consentReceived    Boolean      @default(false)
  consentDate        DateTime?
  consentMethod      String?
  consentFormVersion String?
  consentNotes       String?

  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  lastViewedAt       DateTime?

  babies       Baby[]
  followUps    FollowUp[]

  @@index([consultantId])
  @@index([phone])
  @@index([email])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Baby
// ---------------------------------------------------------------------------
// feedingMethod: BREASTFEEDING | EXPRESSED_BREAST_MILK | FORMULA | MIXED_FEEDING | TUBE_FEEDING | OTHER

model Baby {
  id                  String        @id @default(cuid())
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])

  fullName            String
  dateOfBirth         DateTime?
  sex                 String?
  gestationalAgeWeeks String?
  deliveryType        String?
  birthWeightGrams    Float?
  currentWeightGrams  Float?
  lengthCm            Float?
  headCircumferenceCm Float?
  medicalConditions   String?
  medications         String?
  allergies           String?
  feedingMethod       String?
  dailyFeedsCount     Int?
  supplementationInfo String?
  hospitalInfo        String?
  pediatricianName    String?
  pediatricianPhone   String?
  notes               String?

  archivedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  weightLogs   WeightLog[]
  followUps    FollowUp[]

  @@index([clientId])
}

model WeightLog {
  id          String   @id @default(cuid())
  babyId      String
  baby        Baby     @relation(fields: [babyId], references: [id])
  date        DateTime @default(now())
  weightGrams Float
  createdAt   DateTime @default(now())

  @@index([babyId])
}

// ---------------------------------------------------------------------------
// Follow-ups
// ---------------------------------------------------------------------------
// This is the sole record of a client encounter: either a clinic visit or a
// video meeting, scheduled ahead of time and then documented afterward.
// type: CLINIC_VISIT | VIDEO_MEETING
// status: SCHEDULED | COMPLETED | RESCHEDULED | CANCELLED | MISSED

model FollowUp {
  id          String         @id @default(cuid())
  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  babyId      String?
  baby        Baby?          @relation(fields: [babyId], references: [id])

  scheduledAt DateTime
  type        String         @default("CLINIC_VISIT")
  reason      String?
  notes       String?
  status      String         @default("SCHEDULED")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([scheduledAt])
}

// ---------------------------------------------------------------------------
// Note templates
// ---------------------------------------------------------------------------
// Reusable snippets of text a consultant can insert into a follow-up's notes
// instead of retyping them. Managed entirely by the consultant.

model NoteTemplate {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])

  label        String
  text         String
  sortOrder    Int        @default(0)

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([consultantId])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditEntry {
  id           String     @id @default(cuid())
  consultantId String?
  consultant   Consultant? @relation(fields: [consultantId], references: [id])
  action       String
  entityType   String
  entityId     String?
  details      String?
  ipAddress    String?
  createdAt    DateTime   @default(now())

  @@index([consultantId])
  @@index([entityType, entityId])
}
