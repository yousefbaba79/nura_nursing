# Postgres connection string. Locally: `docker compose up -d` from the repo
# root, then use the value below as-is. In production this is provided
# automatically by Render's managed Postgres (see render.yaml).
DATABASE_URL="postgresql://postgres:localdev@localhost:5432/nura_nursing"

# Generate a strong random value for real deployments, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Render generates this automatically for you (see render.yaml) — you only
# need to set it by hand for local development.
JWT_SECRET="dev-only-change-me-in-production"
JWT_EXPIRES_IN="8h"

PORT=4000

# Must match the origin the frontend is served from, with no trailing slash.
CORS_ORIGIN="http://localhost:5173"

# Set to "production" in real deployments. Among other things this hides the
# password-reset token from the API response (see src/routes/auth.ts) — until
# a real email provider is wired up, retrieve it from the server logs instead.
NODE_ENV="development"
