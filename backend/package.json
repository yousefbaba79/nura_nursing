{
  "name": "nura-nursing-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "prisma generate",
    "deploy": "prisma generate && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply nura-nursing-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply nura-nursing-db --remote"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^5.20.0",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.9",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.5",
    "prisma": "^5.20.0",
    "typescript": "^5.6.2",
    "wrangler": "^4.0.0"
  }
}
